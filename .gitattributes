# Cross-platform text normalization
* text=auto

# Windows launchers must always check out with Windows line endings.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Source/docs use LF in the repository.
*.py text eol=lf
*.lua text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tsv text eol=lf

# Binary release/assets
*.ppf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
